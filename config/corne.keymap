#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

/ {
    macros {
        shifted: shifted {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LSHFT>
                ;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_sym: td_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&shifted>, <&kp>;
        };

        td_both: td_both {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_BOTH";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&shifted>, <&shifted>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        letters_layer {
            bindings = <
&kp ESCAPE    &td_sym N5 Q      &td LA(W) W   &td LA(F) F           &td LA(P) P       &td_sym COMMA B           &td_sym DOT J            &td LEFT_BRACKET L  &td RIGHT_BRACKET U    &td MINUS COMMA  &kp BACKSPACE  &td_sym SEMI SEMI
&kp TAB       &td_sym N2 A      &td_sym N3 R  &hm LALT S            &hm LGUI T        &td_sym LEFT_BRACKET G    &td_sym RIGHT_BRACKET M  &hm RGUI N          &hm RALT E             &td BACKSLASH I  &td_sym BACKSLASH O  &td_sym SLASH SQT
&kp CAPSLOCK  &td_sym N7 Z      &td_sym N4 X  &td_sym N6 C          &td_sym EQUAL D   &td_sym N9 V              &td_sym N0 K             &kp H               &td_sym MINUS SLASH    &td_sym N1 DOT   &td EQUAL Y    &td_both N8 SQT
                                              &kp LEFT_CONTROL       &mt LC(LS(LALT)) SPC     &kp LEFT_SHIFT            &mt LEFT_CONTROL RET     &to 1               &to 2
            >;
        };

        num_and_sym_layer {
            bindings = <
&kp ESCAPE  &td_sym N5 Q   &trans        &trans      &td_sym GRAVE GRAVE  &td_sym COMMA N7           &td_sym DOT N8              &td LEFT_BRACKET N9  &td RIGHT_BRACKET U    &td MINUS COMMA  &kp BACKSPACE  &td_sym SEMI SEMI
&kp TAB     &td_sym N2 A   &td_sym N3 R  &trans      &trans               &td_sym LEFT_BRACKET N4    &td_sym RIGHT_BRACKET N5    &kp N6               &trans                 &td BACKSLASH I  &td_sym BACKSLASH O  &td_sym SLASH SQT
&kp CAPS    &td_sym N7 Z   &td_sym N4 X  &td LCTRL C &td_sym EQUAL N0     &td_sym N9 N1              &td_sym N0 N2               &kp N3               &td_sym MINUS SLASH    &td_sym N1 DOT   &td EQUAL Y    &td_both N8 SQT
                                         &kp LEFT_CONTROL         &to 0        &kp LEFT_SHIFT             &mt LEFT_CONTROL RET        &to 1                &to 2
            >;
        };

        control_layer {
            bindings = <
&trans  &kp LS(LC(LG(NUMBER_4)))  &kp C_PLAY_PAUSE  &kp C_PREV         &kp C_NEXT       &trans            &kp LG(LBKT)          &kp LC(LS(TAB))    &kp RC(TAB)   &kp LG(RBKT)  &trans  &trans
&trans  &kp C_AC_ZOOM_OUT         &kp C_AC_ZOOM_IN  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans            &kp LEFT_ARROW        &kp DOWN           &kp UP_ARROW  &kp RIGHT     &trans  &trans
&trans  &trans                    &trans            &kp C_BRI_DN       &kp C_BRI_UP     &trans            &kp GLOBE             &kp LC(LG(SPACE))  &trans        &trans        &trans  &trans
                                                   &kp LEFT_CONTROL               &to 0        &kp LEFT_SHIFT    &mt LEFT_CONTROL RET  &to 1              &to 2
            >;
        };
    };
};
