#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        letters_layer {
            bindings = <
&kp ESCAPE    &td PERCENT Q  &td LA(W) W   &td LA(F) F           &td LA(P) P  &td LA(B) B       &kp J                 &kp L       &td PLUS U            &td MINUS COMMA  &kp BACKSPACE  &td COLON SEMI
&kp TAB       &td AT A       &td HASH R    &hm LALT S            &hm LGUI T   &kp G             &kp M                 &hm RGUI N  &hm RALT E            &td BACKSLASH I  &td PIPE O     &td QUESTION SQT
&kp CAPSLOCK  &td AMPS Z     &td DOLLAR X  &kp C                 &kp D        &kp V             &kp K                 &kp H       &td UNDERSCORE SLASH  &td EXCL DOT     &td EQUAL Y    &td ASTRK DOUBLE_QUOTES
                                           &mt LC(LS(LALT)) SPC  &kp SPACE    &kp LEFT_SHIFT    &mt LEFT_CONTROL RET  &to 1       &to 2
            >;
        };

        num_and_sym_layer {
            bindings = <
&kp ESCAPE  &td PERCENT Q  &trans        &trans                  &td TILDE GRAVE       &td LESS_THAN N7           &td GREATER_THAN N8             &kp N9  &td PLUS U            &td MINUS COMMA     &kp BACKSPACE  &td COLON SEMICOLON
&kp TAB     &td AT A       &td HASH R    &trans                  &trans                &td LEFT_BRACE N4          &td RIGHT_BRACE N5              &kp N6  &trans                &td PLUS BACKSLASH  &td PIPE O     &td QUESTION SQT
&kp CAPS    &td AMPS Z     &td DOLLAR X  &td LEFT_BRACKET EQUAL  &td RIGHT_BRACKET N0  &td LEFT_PARENTHESIS N1    &td RIGHT_PARENTHESIS NUMBER_2  &kp N3  &td UNDERSCORE SLASH  &td EXCL DOT        &td EQUAL Y    &td ASTRK DOUBLE_QUOTES
                                         &to 0                   &kp SPACE             &kp LEFT_SHIFT             &mt LEFT_CONTROL RET            &to 1   &to 2
            >;
        };

        control_layer {
            bindings = <
&trans  &kp LS(LC(LG(NUMBER_4)))  &kp C_PLAY_PAUSE  &kp C_PREV         &kp C_NEXT       &trans            &kp LG(LBKT)          &kp LC(LS(TAB))    &kp RC(TAB)   &kp LG(RBKT)  &trans  &trans
&trans  &kp LA(LG(MINUS))         &kp LA(LG(PLUS))  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans            &kp LEFT_ARROW        &kp DOWN           &kp UP_ARROW  &kp RIGHT     &trans  &trans
&trans  &trans                    &trans            &kp C_BRI_DN       &kp C_BRI_UP     &trans            &kp GLOBE             &kp LC(LG(SPACE))  &trans        &trans        &trans  &trans
                                                    &to 0              &kp SPACE        &kp LEFT_SHIFT    &mt LEFT_CONTROL RET  &to 1              &to 2
            >;
        };
    };
};
